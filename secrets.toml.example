# Rename to .streamlit/secrets.toml for LOCAL runs, OR paste this content into
# the "Secrets" box on Streamlit Community Cloud. Never commit the real file.

# --- Login (streamlit-authenticator) ---
[cookie]
name = "room_booking_auth"
key = "PUT_A_LONG_RANDOM_STRING_HERE"   # python -c "import secrets; print(secrets.token_hex(32))"
expiry_days = 30

# One block per person. Passwords are plaintext here and hashed automatically
# at runtime. The username (after .usernames.) is what they type to log in.
# Admins are set by EMAIL in app.py (ADMINS).
[credentials.usernames.oded]
email = "odedkushnir@gmail.com"
name = "Oded"
password = "choose-a-password"

[credentials.usernames.sharon]
email = "sharonkushnir@gmail.com"
name = "Sharon"
password = "choose-a-password"

[credentials.usernames.user3]
email = "user3@gmail.com"
name = "User 3"
password = "choose-a-password"

[credentials.usernames.user4]
email = "user4@gmail.com"
name = "User 4"
password = "choose-a-password"

# --- Bookings storage ---
# OPTIONAL. If you omit this whole [database] section, the app uses a local
# SQLite file (bookings.db) — perfect for running locally.
#
# For PERSISTENT storage when deployed online (Streamlit Cloud wipes local
# files on reboot), create a free Postgres DB at neon.tech or supabase.com
# and paste its connection string here. No Google Cloud involved.
#
# [database]
# url = "postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
